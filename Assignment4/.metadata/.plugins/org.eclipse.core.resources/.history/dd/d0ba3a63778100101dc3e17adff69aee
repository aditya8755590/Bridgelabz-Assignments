package com.adityaaa;
import java.util.*;
public class OwnFunctions {
	
	public static  String[] OwnSplit(String s, String by) {
		
		StringBuilder sb=new StringBuilder();
		String[] ans=new String[s.length()];
		int count=0;
		
		for(int i=0;i<s.length();i++) {
			sb.append(s.charAt(i));
		    if (sb.length() >= by.length() && sb.substring(sb.length() - by.length()).equals(by)) {
		            String part = sb.substring(0, sb.length() - by.length());
		            ans[count++] = part;
		            sb.setLength(0);
		        }
			
			
		}
		 if (sb.length() > 0) {
		        ans[count++] = sb.toString();
		    }
		 String[] ans1=new String[count];
		 int n=count;
		 while(count!=0) {
			 ans1[n-count]=ans[n-count];
			 count--;
		 }
		 return ans1;
		
		
		
	}
	public static String  OwnUpperCase(String s){
		StringBuilder sb=new StringBuilder();
		int n=s.length();
		for(int i=0;i<n;i++) {
			int ch=s.charAt(i);
			sb.append((char)(ch-32));
			
		}
		return sb.toString();		
	}
	
	
	public static boolean OwnEqual(String s1,String s2 ) {
		if(s1.toLowerCase().equals(s2.toLowerCase())) {
			return true;
		}
		return false;
	}
	
	public static void CountVowels(String s){
		int count=0;
		for(int i=0;i<s.length();i++) {
			char ch=s.charAt(i);
			if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'){
				count++;
				
			}
		}
		
		return count;
	
	}
	public int OwnLengthWithoutLength(String s) {
		int count=0;
		char[] ss=s.toCharArray();
		for(char c:ss) {
			count++;
			
		}
		return count;
		
	}
	
	
	

}

