public static String OwnSubStringMethod(String s,int idx) {
	 StringBuilder sb=new StringBuilder();
	 for(int i=idx;i<s.length();i++) {
		 sb.append(s.charAt(i));
	 }
	return sb.toString();
	}
 public static char[] OwnCharArray(String s) {
	 int n= s.length();
	 char[] ans=new char[n];
	 for(int i=0;i<n;i++) {
		 ans[i]=s.charAt(i);
	 }
	 return ans;
	 }

